# ========================
# Основные настройки Django
# ========================
DJANGO_SECRET_KEY="replace-me-with-secure-key"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Разрешённые источники CORS (для фронтенда)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ========================
# Настройки базы данных PostgreSQL
# ========================
POSTGRES_DB=habits
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========================
# Часовой пояс
# ========================
TIME_ZONE=UTC

# ========================
# Telegram
# ========================
# Примечание: в рабочем .env укажи реальный токен бота в формате 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=telegram-bot-token-placeholder

# ========================
#  Настройки Celery и Redis
# ========================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================
# Настройки Email (SMTP)
# ========================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com