  # ========================
  # Основные настройки Django
  # ========================
  SECRET_KEY=
  DEBUG=False
  ALLOWED_HOSTS=localhost,127.0.0.1,158.158.158.158,web

  # Статические файлы
  STATIC_ROOT=/app/staticfiles
  STATIC_URL=/static/

  # Разрешённые источники CORS (для фронтенда)
  CORS_ALLOWED_ORIGINS=http://localhost:3000

  # ========================
  # Настройки базы данных PostgreSQL
  # ========================
  POSTGRES_DB=habits
  POSTGRES_USER=habits_user
  POSTGRES_PASSWORD=habits_password
  POSTGRES_HOST=db
  POSTGRES_PORT=5432

  # ========================
  # Дополнительные настройки
  # ========================
  ACCESS_TOKEN_MINUTES=60
  REFRESH_TOKEN_DAYS=7
  PAGE_SIZE=5

  # ========================
  # Часовой пояс
  # ========================
  TIME_ZONE=UTC

  # ========================
  # Telegram
  # ========================
  TELEGRAM_BOT_TOKEN=

  # ========================
  # ⚙Настройки Celery и Redis
  # ========================
  REDIS_URL=redis://redis:6379/0
  REDIS_HOST=redis
  REDIS_PORT=6379
  REDIS_DB=0
  CELERY_BROKER_URL=redis://redis:6379/0
  CELERY_RESULT_BACKEND=redis://redis:6379/1

  # ========================
  # Настройки Email (Yandex SMTP)
  # ========================
  EMAIL_HOST=smtp.yandex.ru
  EMAIL_PORT=465
  EMAIL_USE_TLS=False
  EMAIL_USE_SSL=True
  EMAIL_HOST_USER=jie6e9b@yandex.ru
  EMAIL_HOST_PASSWORD=
  DEFAULT_FROM_EMAIL=jie6e9b@yandex.ru
  EOF